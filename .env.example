# Copy to .env and fill in. Everything except the database works without changes locally.

ENV=dev
LOG_LEVEL=INFO

# Docker Compose overrides these two for the containers.
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5447/booking
REDIS_URL=redis://localhost:6387/0

# Where the web build is served. Telegram opens Mini Apps only over https.
PUBLIC_URL=http://localhost:5177
CORS_ORIGINS=["http://localhost:5177"]

# From @BotFather. Without it the API and the Mini App demo still run, the bot does not.
BOT_TOKEN=
BOT_USERNAME=brass_blade_demo_bot

# At least 32 random characters in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# BotFather > Payments > Stripe TEST or YooKassa TEST. Empty: card deposits use the demo checkout.
PAYMENT_PROVIDER_TOKEN=
PAYMENT_CURRENCY=USD
# Optional: refunds card deposits automatically through Stripe (sk_test_...).
STRIPE_SECRET_KEY=

# Price of one dollar of deposit in Stars, or a fixed symbolic amount for a public demo.
STARS_PER_USD=50
STARS_FIXED_PRICE=

# Public demo: fake checkout, one-click admin login, demo guests, nightly data reset.
DEMO_MODE=true
DEMO_ADMIN_EMAIL=owner@brassblade.demo
DEMO_ADMIN_PASSWORD=demo-owner-2026
